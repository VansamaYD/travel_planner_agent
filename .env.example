# ==============================================================================
# Travel Planner Agent - local integration environment template
# Copy this file to .env and fill values locally. Never commit the real .env.
# Empty optional values mean that the provider is disabled.
# ==============================================================================

# Application
APP_ENV=development
# Docker Compose defaults to production regardless of APP_ENV. Set this only
# for a temporary local preview; production requires a valid APP_MASTER_KEY.
TRAVEL_RUNTIME_ENV=production
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=Asia/Shanghai
APP_LOG_LEVEL=INFO
SESSION_LIFETIME_DAYS=7
SESSION_COOKIE_NAME=travel_session

# External data API budget policy. This applies to map, weather, cloud OCR,
# crawling and similar providers, but not to DeepSeek model calls.
# "free_only" blocks external data operations expected to exceed free quota.
EXTERNAL_API_COST_MODE=free_first
EXTERNAL_API_PAID_BUDGET_CNY=0
EXTERNAL_API_WARNING_THRESHOLDS=0.50,0.75,0.90
EXTERNAL_API_UNKNOWN_PRICE_POLICY=block_paid_operation

# DeepSeek is metered using official peak/off-peak token prices and is not
# blocked by the external free-quota policy.
DEEPSEEK_COST_POLICY=meter_only

# Generate a random value before the application is first started.
APP_MASTER_KEY=

# SQLite is the default lightweight database.
DATABASE_URL=sqlite+aiosqlite:///./data/travel_planner.db

# ----------------------------------------------------------------------------
# Default model: DeepSeek / OpenAI-compatible
# First test set: API key + base URL + one model ID copied from the provider console.
# Do not assume model IDs from documentation remain unchanged.
# ----------------------------------------------------------------------------
MODEL_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Generic OpenAI-compatible fallback or user-defined provider
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# Optional native model providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=

# Model integration test limits
MODEL_TEST_MAX_OUTPUT_TOKENS=2048
MODEL_TEST_TIMEOUT_SECONDS=120
MODEL_TEST_MAX_TOOL_CALLS=6

# ----------------------------------------------------------------------------
# Amap / 高德地图
# Create separate Web Service and Web JS API keys in the Amap console.
# The JS security key is required by JS API 2.0.
# ----------------------------------------------------------------------------
AMAP_WEB_SERVICE_KEY=
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_KEY=

# Amap MCP currently uses a Web Service key. It may equal the test Web Service
# key, but is kept separate here so it can be rotated or restricted later.
AMAP_MCP_KEY=
AMAP_MCP_ENDPOINT=https://mcp.amap.com/mcp

# ----------------------------------------------------------------------------
# Baidu Maps / 百度地图（optional second test set）
# Use separate server-side and browser-side AKs.
# ----------------------------------------------------------------------------
BAIDU_MAP_SERVER_AK=
BAIDU_MAP_SERVER_SK=
BAIDU_MAP_JS_AK=

# ----------------------------------------------------------------------------
# QWeather / 和风天气（recommended first test set）
# For a quick PoC, API key mode is accepted. JWT is the recommended target.
# API host is assigned by QWeather and must not be guessed.
# ----------------------------------------------------------------------------
QWEATHER_AUTH_MODE=api_key
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# JWT target configuration; keep the private key in a mounted secrets file.
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PRIVATE_KEY_FILE=./secrets/qweather-ed25519-private.pem

# External tool cache. Expired entries may be served during an upstream outage
# until the stale window closes; every such response is visibly marked stale.
EXTERNAL_TOOL_TIMEOUT_SECONDS=15
MAP_CACHE_TTL_SECONDS=604800
ROUTE_CACHE_TTL_SECONDS=1800
WEATHER_CACHE_TTL_SECONDS=7200
EXTERNAL_CACHE_STALE_SECONDS=604800

# Optional read-only Xiaohongshu MCP worker. The main app registers search and
# detail reads only; write/interaction tools exposed by an upstream are ignored.
XHS_RESEARCH_ENABLED=false
XHS_MCP_ENDPOINT=http://xhs-browser-worker:18060/mcp
XHS_SEARCH_TIMEOUT_SECONDS=45
XHS_SEARCH_CACHE_TTL_SECONDS=21600
XHS_MAX_RESULTS_PER_QUERY=8

# ----------------------------------------------------------------------------
# OCR（optional）
# PaddleOCR is local and needs no API key. Baidu OCR is a cloud fallback.
# ----------------------------------------------------------------------------
OCR_DEFAULT_PROVIDER=paddleocr
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ----------------------------------------------------------------------------
# Web extraction（optional second test set）
# ----------------------------------------------------------------------------
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Playwright is local and disabled by default to preserve memory.
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_MAX_CONCURRENCY=1

# ----------------------------------------------------------------------------
# SMTP notifications（optional）
# Port/TLS mode is provider-specific. For smtp.163.com the tested setting is
# port 465 with implicit TLS; the application infers implicit TLS from 465.
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=

# ----------------------------------------------------------------------------
# Integration test behavior
# ----------------------------------------------------------------------------
INTEGRATION_TEST_LIVE=false
INTEGRATION_TEST_CITY=北京市
INTEGRATION_TEST_ORIGIN=116.397499,39.908722
INTEGRATION_TEST_DESTINATION=116.481028,39.989643
INTEGRATION_TEST_CACHE_RAW_RESPONSES=true
INTEGRATION_TEST_RAW_RESPONSE_DIR=./data/integration-fixtures
