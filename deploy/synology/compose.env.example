# Non-secret Docker Compose settings for Synology NAS.
TRAVEL_RUNTIME_ENV=production
TRAVEL_WEB_PORT=8080
TRAVEL_DATA_DIR=/volume1/docker/travel_planner/data
TRAVEL_CONFIG_DIR=/volume1/docker/travel_planner/config/runtime
TRAVEL_BOOTSTRAP_ENV_FILE=/volume1/docker/travel_planner/config/bootstrap.env
